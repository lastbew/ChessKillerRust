# Copy this to .env and fill it in.

# Your Lichess personal access token (scope: board:play).
LICHESS_TOKEN=

# Optional: challenge this Lichess username to an unrated game.
# Leave blank to play a game that's already running.
CHALLENGE_USERNAME=

# 1 = print moves but do NOT send them (safe); 0 = really play.
DRY_RUN=1

# Training-wheels: how long Stockfish may think per move (ms).
MOVE_TIME_MS=800

# When challenging: clock minutes + increment seconds.
CLOCK_MINUTES=3
CLOCK_INCREMENT=2

# Path to the Stockfish executable. If blank, it looks in ./engines/.
STOCKFISH_PATH=
